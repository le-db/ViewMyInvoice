<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop;net10.0</TargetFrameworks>

    <!--
      Release enables PublishTrimmed, so the SDK defaults PublishRuntimeIdentifier to the host RID (win-x64)
      and adds it to RuntimeIdentifiers. Android then fails with XA0035 / NU1102 (no Mono win-x64 runtime pack).
    -->
    <UseDefaultPublishRuntimeIdentifier Condition="'$(TargetFramework)' == 'net10.0-android'">false</UseDefaultPublishRuntimeIdentifier>

    <!--
      Uno.Extensions persists the selected language (internal LocalizationSettings type) with reflection-based
      System.Text.Json, which is disabled by default in trimmed builds and made the WASM language switch throw.
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>ViewMyInvoice</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.tpsg.ViewMyInvoice</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>le-db</ApplicationPublisher>
    <!-- Package Description -->
    <Description>ViewMyInvoice powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Dsp;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      <!--HttpKiota;-->
      Serialization;
      Localization;
      Navigation;
      ThemeService;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>
    <!--
      Program.cs uses the Win32 host, so the WPF runtime is never loaded. Uno.Sdk.Extras still bundles the WPF
      shared framework into self-contained Windows publishes and refuses to do so when cross-publishing
      (win-x86 / win-arm64 from an x64 host). Opt out of that step.
    -->
    <Target Name="_ViewMyInvoiceSkipWpfBundle" AfterTargets="_DetermineUnoAddWpfToPublishDirectory">
        <PropertyGroup>
            <_UnoPublishWpfSelfContained></_UnoPublishWpfSelfContained>
        </PropertyGroup>
    </Target>
    <ItemGroup>
        <Content Include="Assets\Resources\*.xml" />
        <EmbeddedResource Include="invoice_fields.*.json" LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>
    <ItemGroup>
      <Compile Update="Presentation\InvoiceView.xaml.cs">
        <DependentUpon>InvoiceView.xaml</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
